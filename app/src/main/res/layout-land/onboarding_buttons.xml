<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/MaterialAppTheme"
    tools:background="@color/styleguide_dark"
    >

  <com.appcoins.wallet.ui.widgets.WalletButtonView
      android:id="@+id/onboarding_next_button"
      android:layout_width="0dp"
      android:layout_height="@dimen/onboarding_button_height"
      android:layout_marginStart="8dp"
      app:buttonText="@string/onboarding_sign_in_button"
      app:buttonType="filled"
      app:layout_constraintBottom_toBottomOf="@id/onboarding_create_local_wallet_button"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@id/onboarding_create_local_wallet_button"
      app:layout_constraintTop_toTopOf="@id/onboarding_create_local_wallet_button"
      />
  <com.appcoins.wallet.ui.widgets.WalletButtonView
      android:id="@+id/onboarding_create_local_wallet_button"
      android:layout_width="0dp"
      android:layout_height="@dimen/onboarding_button_height"
      android:layout_marginEnd="@dimen/normal_margin"
      app:buttonColor="@color/styleguide_white"
      app:buttonText="@string/onboarding_create_local_wallet_button"
      app:buttonType="outlined"
      app:layout_constraintBottom_toTopOf="@+id/onboarding_load_backup_button"
      app:layout_constraintEnd_toStartOf="@+id/onboarding_next_button"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      />
  <com.appcoins.wallet.ui.widgets.WalletButtonView
      android:id="@+id/onboarding_load_backup_button"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/onboarding_button_height"
      android:layout_marginTop="4dp"
      android:layout_marginBottom="@dimen/normal_margin"
      app:buttonColor="@color/styleguide_dark_grey"
      app:buttonText="@string/onboarding_load_backup_button"
      app:buttonType="text"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/onboarding_create_local_wallet_button"
      />

</androidx.constraintlayout.widget.ConstraintLayout>
